[Unit]
Description=UniQbd NestJS API
Wants=network-online.target
After=network-online.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=uniqbd
Group=uniqbd
WorkingDirectory=/opt/uniqbd.com/apps/api
EnvironmentFile=/opt/uniqbd.com/apps/api/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/uniqbd.com/apps/api/dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/uniqbd.com/uploads
UMask=0027

[Install]
WantedBy=multi-user.target
