# Production: /opt/uniqbd.com/apps/web/.env.local (uniqbd:uniqbd, mode 0640).
# setup-env.sh creates this from the example. Re-run deploy.sh after changing
# NEXT_PUBLIC_* because Next.js embeds them at build time.
NEXT_PUBLIC_API_URL=https://api.uniqbd.com/api
NEXT_PUBLIC_WS_URL=https://api.uniqbd.com
NEXT_PUBLIC_SITE_URL=https://uniqbd.com
# Optional grey-cloud host for Samba uploads over ~100MB (see deploy/deploy/aapanel/nginx/upload.uniqbd.com.conf):
# NEXT_PUBLIC_LARGE_UPLOAD_ORIGIN=https://upload.uniqbd.com
INTERNAL_API_URL=http://127.0.0.1:4000/api
