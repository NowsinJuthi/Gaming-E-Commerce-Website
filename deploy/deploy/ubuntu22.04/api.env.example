# Production: /opt/uniqbd.com/apps/api/.env (uniqbd:uniqbd, mode 0640).
# Or: sudo bash deploy/deploy/ubuntu22.04/setup-env.sh
# All upload files (products, logos, live-chat images) → UPLOADS_DIR below.
NODE_ENV=production
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4000
API_GLOBAL_PREFIX=api
API_CORS_ORIGIN=https://uniqbd.com,https://www.uniqbd.com,https://api.uniqbd.com
API_PUBLIC_URL=https://api.uniqbd.com/api
APP_PUBLIC_URL=https://uniqbd.com
WEB_APP_URL=https://uniqbd.com
UPLOADS_DIR=/opt/uniqbd.com/uploads

# MongoDB Atlas (replace credentials, cluster and database).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/uniqbd?retryWrites=true&w=majority
MONGODB_MAX_POOL=50
MONGODB_MIN_POOL=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_AUTO_INDEX=false

# Native Redis bound to localhost.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_OPTIONAL=false

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
JWT_REFRESH_TTL=2592000
# JWT_GUEST_REFRESH_TTL=86400
DATA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# License vendor (server-only — not editable in admin dashboard). From license.amarpin.com.
LICENSE_SITE_SECRET=
# LICENSE_API_URL=https://license.amarpin.com/api
# LICENSE_PRODUCT_ID=amarpin-pro
# LICENSE_WEBSITE_ID=uniqbd.com

TRUST_PROXY_HOPS=1
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
THROTTLE_BLOCK_MS=60000
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=30
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
ACTIVITY_TRACKING=true
ACTIVITY_RETENTION_DAYS=60

SMTP_HOST=mail.uniqbd.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@uniqbd.com
SMTP_PASS=
SMTP_FROM_NAME=UniQbd
SMTP_FROM_EMAIL=no-reply@uniqbd.com
ADMIN_ALERT_EMAIL=support@uniqbd.com

EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@uniqbd.com
FCM_SERVER_KEY=
FCM_URL=https://fcm.googleapis.com/fcm/send
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_WEBHOOK_SECRET=
ROCKET_BASE_URL=
ROCKET_API_KEY=
ROCKET_API_SECRET=
ROCKET_WEBHOOK_SECRET=
UPAY_BASE_URL=
UPAY_API_KEY=
UPAY_API_SECRET=
UPAY_WEBHOOK_SECRET=
UDDOKTAPAY_BASE_URL=
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_WEBHOOK_SECRET=

MFS_APP_ACCESS_TTL_SECONDS=900
MFS_APP_REFRESH_TTL_SECONDS=2592000
MFS_SMS_SYNC_TOKEN=REPLACE_WITH_RANDOM_MFS_SMS_SYNC_TOKEN
MFS_DEFAULT_BKASH_NUMBER=01700000001
MFS_DEFAULT_NAGAD_NUMBER=01700000002

RELOADLY_BASE_URL=
RELOADLY_API_KEY=
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
XSOLLA_BASE_URL=
XSOLLA_API_KEY=
XSOLLA_MERCHANT_ID=
TURGAME_BASE_URL=
TURGAME_API_KEY=
TURGAME_API_SECRET=
FOXRELOAD_BASE_URL=
FOXRELOAD_API_KEY=
FOXRELOAD_API_SECRET=
