# =============================================================================
# UniQbd production — aaPanel / VPS
# Copy redacted templates on the server, then fill secrets there:
#   cp deploy/deploy/aapanel/.env.production.example .env
#   cp deploy/deploy/aapanel/web.env.production.example apps/web/.env.production.local
# Domains:  uniqbd.com (web)  |  api.uniqbd.com (API)
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# ---- API ----
API_PORT=4000
API_GLOBAL_PREFIX=api
API_CORS_ORIGIN=https://uniqbd.com,https://www.uniqbd.com,https://api.uniqbd.com
API_PUBLIC_URL=https://api.uniqbd.com/api
APP_PUBLIC_URL=https://uniqbd.com
WEB_APP_URL=https://uniqbd.com

# ---- Uploads (images) ----
# Disk path on aaPanel. URLs stored as /api/uploads/... (not full http:// IP)
# mkdir -p uploads/{products,logos,banners,avatars,mfs-qr,live-chat}
# chown -R www:www uploads && chmod -R 755 uploads
UPLOADS_DIR=/www/wwwroot/uniqbd.com/uploads

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/uniqbd
MONGODB_MAX_POOL=50
MONGODB_MIN_POOL=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_AUTO_INDEX=false

# ---- Redis (required in production) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_OPTIONAL=false

# ---- Auth ----
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Registered admin/customer — 10 years until explicit logout (web only)
JWT_REFRESH_TTL=315360000
# Guest checkout/chat only (24 hours) — optional override
# JWT_GUEST_REFRESH_TTL=86400

# ---- Encryption ----
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# ---- Edge / security ----
# 1 = nginx only. 2 = Cloudflare + nginx.
TRUST_PROXY_HOPS=1
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
THROTTLE_BLOCK_MS=60000
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=30
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
ACTIVITY_TRACKING=true
ACTIVITY_RETENTION_DAYS=60

# ---- SMTP / email ----
SMTP_HOST=mail.uniqbd.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@uniqbd.com
SMTP_PASS=
SMTP_FROM_NAME=UniQbd
SMTP_FROM_EMAIL=no-reply@uniqbd.com
ADMIN_ALERT_EMAIL=support@uniqbd.com

# ---- Notifications ----
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@uniqbd.com
FCM_SERVER_KEY=
FCM_URL=https://fcm.googleapis.com/fcm/send
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# ---- Payment gateways ----
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_WEBHOOK_SECRET=
ROCKET_BASE_URL=
ROCKET_API_KEY=
ROCKET_API_SECRET=
ROCKET_WEBHOOK_SECRET=
UPAY_BASE_URL=
UPAY_API_KEY=
UPAY_API_SECRET=
UPAY_WEBHOOK_SECRET=
UDDOKTAPAY_BASE_URL=
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_WEBHOOK_SECRET=

# ---- MFS SMS app ----
# Paymently Base URL: https://uniqbd.com/api/app
# Session length for the Android SMS app ONLY — does NOT change web JWT_ACCESS_TTL.
# Default when unset: 10 years (stay logged in until explicit logout in the app).
MFS_APP_ACCESS_TTL_SECONDS=315360000
MFS_APP_REFRESH_TTL_SECONDS=315360000
MFS_SMS_SYNC_TOKEN=
MFS_DEFAULT_BKASH_NUMBER=01700000001
MFS_DEFAULT_NAGAD_NUMBER=01700000002

# ---- Suppliers ----
RELOADLY_BASE_URL=
RELOADLY_API_KEY=
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
XSOLLA_BASE_URL=
XSOLLA_API_KEY=
XSOLLA_MERCHANT_ID=
TURGAME_BASE_URL=
TURGAME_API_KEY=
TURGAME_API_SECRET=
FOXRELOAD_BASE_URL=
FOXRELOAD_API_KEY=
FOXRELOAD_API_SECRET=
