# =============================================================================
# Next.js production env
# Copy to: /www/wwwroot/uniqbd.com/apps/web/.env.production.local
# Rebuild after changing NEXT_PUBLIC_*:
#   corepack pnpm --filter @uniqbd/web build && pm2 restart uniqbd-web
# =============================================================================

NEXT_PUBLIC_API_URL=https://api.uniqbd.com/api
NEXT_PUBLIC_WS_URL=https://api.uniqbd.com
NEXT_PUBLIC_SITE_URL=https://uniqbd.com
# Used by Next.js /api/uploads rewrite at build time (server-side proxy).
INTERNAL_API_URL=http://127.0.0.1:4000/api
