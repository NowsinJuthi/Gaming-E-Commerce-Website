{
  "name": "uniqbd",
  "version": "0.1.0",
  "private": true,
  "description": "UniQbd digital-goods marketplace monorepo (Next.js 15 + NestJS 11)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "corepack pnpm -r --parallel --filter @uniqbd/web --filter @uniqbd/api dev",
    "dev:web": "corepack pnpm --filter @uniqbd/web dev",
    "dev:api": "corepack pnpm --filter @uniqbd/api dev",
    "dev:turbo": "turbo run dev",
    "seed": "corepack pnpm --filter @uniqbd/api seed",
    "seed:users": "corepack pnpm --filter @uniqbd/api seed:users",
    "db:setup": "corepack pnpm --filter @uniqbd/api db:setup",
    "db:setup:full": "corepack pnpm --filter @uniqbd/api db:setup:full",
    "seed:game-topup": "corepack pnpm --filter @uniqbd/api seed:game-topup",
    "seed:blog-categories": "corepack pnpm --filter @uniqbd/api seed:blog-categories",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
