NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side fetches + Next.js /api proxy target (LAN / production)
INTERNAL_API_URL=http://127.0.0.1:4000/api
# API_PROXY_TARGET=http://127.0.0.1:4000
# Optional comma-separated HTTPS origins allowed by next/image in production.
# NEXT_PUBLIC_IMAGE_HOSTS=https://cdn.example.com

# LAN example (phone / other PCs on your network):
# NEXT_PUBLIC_SITE_URL=http://103.114.38.220:3000
# NEXT_PUBLIC_API_URL=http://103.114.38.220:4000/api
# NEXT_PUBLIC_WS_URL=http://103.114.38.220:4000

# Production: systemd loads /etc/uniqbd/web.env; deploy.sh exports it during
# `next build`. Do not store production env files in this source tree.
