# Local development template. Copy to `.env` and `apps/api/.env`.
# Never commit real secrets. Production API: apps/api/.env on the server.

NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api
API_CORS_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api
APP_PUBLIC_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
UPLOADS_DIR=

MONGODB_URI=mongodb://127.0.0.1:27017/uniqbd

JWT_ACCESS_SECRET=change-me-access-dev-only-min-8
JWT_REFRESH_SECRET=change-me-refresh-dev-only-min-8
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=315360000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

DATA_ENCRYPTION_KEY=
LICENSE_SITE_SECRET=
LICENSE_API_URL=
LICENSE_PRODUCT_ID=
LICENSE_WEBSITE_ID=
TRUST_PROXY_HOPS=1

RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=

MFS_SMS_SYNC_TOKEN=
MFS_APP_ACCESS_TTL_SECONDS=315360000
MFS_APP_REFRESH_TTL_SECONDS=315360000

# Dev-only synthetic payment/supplier sandbox. Forbidden in production.
ALLOW_SANDBOX_INTEGRATIONS=true
REDIS_OPTIONAL=true
# Temporary production hatch while encrypting leftover inventory/codes.
ALLOW_LEGACY_PLAINTEXT_SECRETS=false
